# ===== Required =====

# 1) Telegram bot token from @BotFather (send /newbot). Looks like 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# 2) API key from the provider you picked (DeepSeek, OpenAI or Anthropic).
API_KEY=

# 3) Who is allowed to use the bot: Telegram numeric user id, not @username.
#    Leave it empty on the first run, send /whoami to the bot, then paste the id here.
#    Comma-separated, e.g. 111111,222222
ALLOWED_USER_IDS=

# ===== Provider =====

# deepseek  — DeepSeek's API; supports thinking / reasoning_effort
# openai    — OpenAI's API; no thinking switch
# anthropic — Claude's native /v1/messages API; supports a thinking budget
PROVIDER=deepseek

# Base URL. Leave it commented out and the provider default is used:
#   DeepSeek   https://api.deepseek.com
#   OpenAI     https://api.openai.com/v1
#   Anthropic  https://api.anthropic.com
# Only set it for a proxy or a self-hosted gateway.
# API_BASE_URL=

# Model id, exactly as your provider names it. Required when PROVIDER is not deepseek.
DEFAULT_MODEL=deepseek-flash

# ===== Optional =====

# Thinking mode: DeepSeek and Claude only. On, it reasons first — slower and pricier.
DEFAULT_THINKING=false

# Replace the built-in system prompt (leave commented out to keep the default)
# SYSTEM_PROMPT=You are a concise assistant.

# How much conversation to keep
HISTORY_MAX_MESSAGES=40
HISTORY_MAX_CHARS=48000

# Cap on output tokens per reply (leave empty to use the provider's default)
# MAX_OUTPUT_TOKENS=

# Minimum seconds between streaming edits. Do not go below 0.5 — Telegram will rate-limit you.
EDIT_INTERVAL=1.2

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO
